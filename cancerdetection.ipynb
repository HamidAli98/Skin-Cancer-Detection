            "import os\n",
            "import numpy as np\n",
            "import streamlit as st\n",
            "import torch\n",
            "import torch.nn as nn\n",
            "from PIL import Image\n",
            "from torchvision import models, transforms\n",
            "\n",
            "MODEL_PATH = \"skin_model.pt\"   # produced by train_skin_model_pytorch.ipynb\n",
            "\n",
            "FULL_NAMES = {\n",
            "    \"akiec\": \"Actinic keratosis / intraepithelial carcinoma\",\n",
            "    \"bcc\": \"Basal cell carcinoma\",\n",
            "    \"bkl\": \"Benign keratosis-like lesion\",\n",
            "    \"df\": \"Dermatofibroma\",\n",
            "    \"mel\": \"Melanoma\",\n",
            "    \"nv\": \"Melanocytic nevus (common mole)\",\n",
            "    \"vasc\": \"Vascular lesion\",\n",
            "}\n",
            "NEEDS_ATTENTION = {\"akiec\", \"bcc\", \"mel\"}   # malignant / pre-malignant classes in HAM10000\n",
            "\n",
            "st.set_page_config(page_title=\"Skin Lesion Classifier\", page_icon=\"🩺\", layout=\"centered\")\n",
            "st.title(\"🩺 Skin Lesion Classifier\")\n",
            "st.caption(\"Educational demo trained on HAM10000. Not a medical device and not a diagnosis.\")\n",
            "\n",
            "if not os.path.exists(MODEL_PATH):\n",
            "    st.error(\n",
            "        f\"`{MODEL_PATH}` not found. Run `train_skin_model_pytorch.ipynb` in Google Colab, \"\n",
            "        \"download `skin_model.pt`, and place it next to `app.py`.\"\n",
            "    )\n",
            "    st.stop()\n",
            "\n",
            "\n",
            "@st.cache_resource\n",
            "def load_model():\n",
            "    ckpt = torch.load(MODEL_PATH, map_location=\"cpu\", weights_only=True)\n",
            "    classes = ckpt[\"classes\"]\n",
            "    model = models.efficientnet_b0(weights=None)\n",
            "    model.classifier[1] = nn.Linear(model.classifier[1].in_features, len(classes))\n",
            "    model.load_state_dict(ckpt[\"state_dict\"])\n",
            "    model.eval()\n",
            "    return model, classes, ckpt.get(\"img_size\", 224)\n",
            "\n",
            "\n",
            "model, classes, img_size = load_model()\n",
            "preprocess = transforms.Compose([\n",
            "    transforms.Resize((img_size, img_size)),\n",
            "    transforms.ToTensor(),\n",
            "    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n",
            "])\n",
            "\n",
            "st.write(\"Upload a close-up (ideally dermoscopic) photo of a single skin lesion.\")\n",
            "file = st.file_uploader(\"Image\", type=[\"jpg\", \"jpeg\", \"png\"])\n",
            "\n",
            "if file is not None:\n",
            "    image = Image.open(file).convert(\"RGB\")\n",
            "    st.image(image, caption=\"Uploaded image\", use_container_width=True)\n",
            "\n",
            "    with st.spinner(\"Analyzing...\"):\n",
            "        with torch.no_grad():\n",
            "            probs = torch.softmax(model(preprocess(image).unsqueeze(0)), dim=1)[0].numpy()\n",
            "\n",
            "    order = np.argsort(-probs)\n",
            "    top = classes[order[0]]\n",
            "    st.subheader(f\"Most likely: {FULL_NAMES.get(top, top)}\")\n",
            "    st.progress(float(probs[order[0]]), text=f\"Model confidence: {probs[order[0]]:.1%}\")\n",
            "\n",
            "    risky = sum(probs[i] for i, c in enumerate(classes) if c in NEEDS_ATTENTION)\n",
            "    st.metric(\"Combined probability of melanoma / BCC / actinic keratosis\", f\"{risky:.1%}\")\n",
            "    if risky >= 0.30 or top in NEEDS_ATTENTION:\n",
            "        st.warning(\"The model flags this as possibly concerning. Please have a dermatologist look at it.\")\n",
            "    else:\n",
            "        st.info(\"The model sees this as likely benign, but it can be wrong. \"\n",
            "                \"If a lesion is changing, bleeding, itching or growing, see a doctor regardless.\")\n",
            "\n",
            "    st.write(\"**All class probabilities**\")\n",
            "    st.bar_chart({FULL_NAMES.get(c, c): float(p) for c, p in zip(classes, probs)})\n",
            "\n",
            "st.divider()\n",
            "st.caption(\"Trained on a single public dataset that skews toward lighter skin tones and dermoscopy images; \"\n",
            "           \"accuracy on phone photos or other populations may be much lower.\")\n",
            "\n"
          ]
        }
      ]
    }
  ]
